# Matches the env: block in .github/workflows/deploy.yml.
# Placeholder values only.

# Database
DATABASE_URL="sqlserver://HOST:1433;database=DATABASE;user=USER;password=PASSWORD;trustServerCertificate=true"

# Auth
AUTH_SECRET="generate-a-random-32-char-string"
AUTH_URL="https://example.com"
AUTH_TRUST_HOST="true"

# SendGrid
SENDGRID_API_KEY="CHANGE_ME"

# SMS Gateway
SMS_API_URL="https://example.com/message"
SMS_USERNAME="CHANGE_ME"
SMS_PASSWORD="CHANGE_ME"
SMS_DEVICE_ID="CHANGE_ME"
SMS_WEBHOOK_SECRET="CHANGE_ME"

# Lead scraper worker
SCRAPER_API_SECRET="CHANGE_ME"

# App
NEXT_PUBLIC_APP_NAME="PulseBC"
