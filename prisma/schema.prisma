generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
  engineType    = "library"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["dbo", "benjaise_sqluser", "benjaise_sqluser2"]
}

model User {
  idUser      Int      @id @default(autoincrement()) @map("IdUser")
  name        String?  @map("Name")
  lastname    String?  @map("Lastname")
  email       String?  @unique @map("Email")
  password    String?  @map("Password")
  idRole      Int?     @map("IdRole")
  timeZone    String?  @map("TimeZone")
  city        String?  @map("City")
  state       String?  @map("State")
  country     String?  @map("Country")
  sendEmail   Int?     @default(0) @map("SendEmail")
  status      Boolean? @default(true) @map("Status")
  isPartTime  Boolean? @default(false) @map("IsPartTime")
  // Breaks taken and their order, e.g. "lunch,firstBreak,secondBreak".
  // NULL = default for full/part time, "" = none. See src/lib/clock/break-order.ts.
  breakOrder  String?  @map("BreakOrder") @db.NVarChar(40)
  smsAccess   Boolean? @default(false) @map("SmsAccess")
  photo       String?  @map("Photo") @db.NVarChar(Max)
  resetToken  String?  @map("ResetToken") @db.NVarChar(200)
  resetExpires DateTime? @map("ResetExpires")
  payRate     Decimal? @map("PayRate") @db.Decimal(10, 2)
  otPayRate   Decimal? @map("OtPayRate") @db.Decimal(10, 2)

  role        Role?    @relation(fields: [idRole], references: [idRole])
  calls       Call[]   @relation("UserCalls")
  closedCalls Call[]   @relation("CloserCalls")

  timeLogs             EmployeeTimeLog[]
  schedules            EmployeeSchedule[]
  disconnections       EmployeeDisconnection[] @relation("DisconnectedUser")
  bonuses              PayrollBonus[]          @relation("BonusUser")
  payStatements        PayStatement[]          @relation("PayStatementUser")
  payRateHistory       PayRateHistory[]        @relation("PayRateHistoryUser")
  videoViews           VideoView[]
  activityLogs         UserActivityLog[]

  assignedComputers    Computer[]            @relation("ComputerUser")
  computerAssignments  ComputerAssignment[]  @relation("ComputerAssignments")
  maintenancesPerformed MaintenanceLog[]     @relation("MaintenanceTechnician")
  ticketsReported      MaintenanceTicket[]   @relation("TicketReporter")
  ticketsAssigned      MaintenanceTicket[]   @relation("TicketAssignee")

  @@map("Users")
  @@schema("dbo")
}

model Role {
  idRole Int    @id @map("IdRole")
  role   String @map("Role")

  users       User[]
  permissions RolePermission[]

  @@map("Roles")
  @@schema("dbo")
}

model Business {
  idBusiness   Int     @id @default(autoincrement()) @map("IdBusiness")
  businessName String? @map("BusinessName")
  phone        String? @map("Phone")
  phoneDigits  String? @map("PhoneDigits")
  address      String? @map("Address")
  location     String? @map("Location")
  industry     String? @map("Industry")
  timeZone     String? @map("TimeZone")
  idStatus     Int?    @map("IdStatus")
  /// Set when a lead is handed to an agent; cleared when the call is logged or
  /// reverted. next-lead releases rows older than the expiry. NULL on the rows
  /// that were already stuck at status 1 before the expiry existed.
  onCallSince  DateTime? @map("OnCallSince")
  /// Which directory this lead came from. NULL for everything imported before
  /// there was more than one, which is honest rather than guessing 'yp'.
  source       String?   @map("Source") @db.NVarChar(10)

  calls        Call[]

  @@unique([phoneDigits], map: "UX_Businesses_PhoneDigits")
  @@index([idStatus, industry], map: "IX_Businesses_Status_Industry")
  @@index([idStatus, timeZone], map: "IX_Businesses_Status_TimeZone")
  // IX_Businesses_OnCallSince is filtered to IdStatus = 1, which Prisma cannot
  // express. See the 20260807 migration.
  @@index([onCallSince], map: "IX_Businesses_OnCallSince")
  @@index([businessName], map: "IX_Businesses_Name")
  // IX_Businesses_PhoneDigits also carries INCLUDE (IdBusiness, BusinessName,
  // Phone, IdStatus), which Prisma cannot express. See the 20260730 migration.
  @@index([phoneDigits], map: "IX_Businesses_PhoneDigits")
  @@map("Businesses")
  @@schema("dbo")
}

model Disposition {
  idDisposition Int    @id @map("IdDisposition")
  disposition   String @map("Disposition")

  calls         Call[]

  @@map("Dispositions")
  @@schema("dbo")
}

model Call {
  idCall          Int       @id @default(autoincrement()) @map("IdCall")
  idUser          Int       @map("IdUser")
  idBusiness      Int       @map("IdBusiness")
  idDisposition   Int?      @map("IdDisposition")
  callDate        DateTime  @map("CallDate")
  comments        String?   @map("Comments")
  idCloser        Int?      @map("IdCloser")
  dMakerName      String?   @map("DMakerName")
  dMPhone         String?   @map("DMPhone")
  dMEmail         String?   @map("DMEmail")
  pDebtorName     String?   @map("PDebtorName")
  pDebtorAmmount  String?   @map("PDebtorAmmount")
  porcentageCircle String?  @map("PorcentageCircle")
  agreementSent   String?   @map("AgreementSent")
  how             String?   @map("How")
  callBack        DateTime? @map("CallBack") @db.Date

  user            User        @relation("UserCalls", fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  business        Business    @relation(fields: [idBusiness], references: [idBusiness], onDelete: NoAction, onUpdate: NoAction)
  disposition     Disposition? @relation(fields: [idDisposition], references: [idDisposition], onDelete: NoAction, onUpdate: NoAction)
  closer          User?       @relation("CloserCalls", fields: [idCloser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@index([idUser, callDate], map: "IX_Calls_User_Date")
  @@index([idDisposition, callDate], map: "IX_Calls_Disposition_Date")
  @@index([callDate], map: "IX_Calls_Date")
  @@map("Calls")
  @@schema("dbo")
}

model Quote {
  idQuote Int    @id @default(autoincrement()) @map("idQuote")
  quote   String @map("Quote")

  @@map("Quotes")
  @@schema("dbo")
}

model Rebuttal {
  idRebuttal   Int       @id @default(autoincrement()) @map("IdRebuttal")
  title        String    @map("Title")
  content      String    @map("Content")
  createdDate  DateTime? @map("CreatedDate")
  modifiedDate DateTime? @map("ModifiedDate")
  isActive     Boolean?  @default(true) @map("IsActive")

  @@map("Rebuttals")
  @@schema("benjaise_sqluser2")
}

model EmployeeTimeLog {
  timeLogId         Int      @id @default(autoincrement()) @map("TimeLogID")
  idUser            Int      @map("IdUser")
  logDate           DateTime @map("LogDate") @db.Date
  clockIn           DateTime? @map("ClockIn") @db.Time
  firstBreakOut     DateTime? @map("FirstBreakOut") @db.Time
  firstBreakIn      DateTime? @map("FirstBreakIn") @db.Time
  lunchOut          DateTime? @map("LunchOut") @db.Time
  lunchIn           DateTime? @map("LunchIn") @db.Time
  secondBreakOut    DateTime? @map("SecondBreakOut") @db.Time
  secondBreakIn     DateTime? @map("SecondBreakIn") @db.Time
  clockOut          DateTime? @map("ClockOut") @db.Time
  totalHours        Decimal?  @map("TotalHours")
  overtimeHours     Decimal?  @map("OvertimeHours")
  isModifiedByAdmin Boolean?  @default(false) @map("IsModifiedByAdmin")
  hasDisconnections Boolean?  @default(false) @map("HasDisconnections")

  user              User     @relation(fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idUser, logDate], map: "UQ_EmployeeTimeLog_User_Date")
  @@map("EmployeeTimeLog")
  @@schema("benjaise_sqluser2")
}

model EmployeeTimeLogAudit {
  auditId        Int       @id @default(autoincrement()) @map("AuditId")
  timeLogId      Int?      @map("TimeLogId")
  idUser         String    @map("IdUser")
  modifiedBy     String    @map("ModifiedBy")
  modifiedDate   DateTime  @map("ModifiedDate")
  fieldModified  String    @map("FieldModified")
  oldValue       DateTime? @map("OldValue") @db.Time
  newValue       DateTime? @map("NewValue") @db.Time
  reason         String    @map("Reason")

  @@map("EmployeeTimeLogAudit")
  @@schema("benjaise_sqluser2")
}

model EmployeeSchedule {
  scheduleId Int       @id @default(autoincrement()) @map("ScheduleID")
  idUser     Int       @map("IdUser")
  dayOfWeek  String    @map("DayOfWeek")
  startTime  DateTime  @map("StartTime") @db.Time
  endTime    DateTime  @map("EndTime") @db.Time

  user       User      @relation(fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@map("EmployeeSchedule")
  @@schema("benjaise_sqluser2")
}

model EmployeeDisconnection {
  idDisconnection    Int       @id @default(autoincrement()) @map("IdDisconnection")
  idUser             Int       @map("IdUser")
  disconnectionDate  DateTime  @map("DisconnectionDate") @db.Date
  disconnectionTime  DateTime  @map("DisconnectionTime") @db.Time
  reconnectionTime   DateTime? @map("ReconnectionTime") @db.Time
  reason             String?   @map("Reason")
  disconnectionType  String?   @map("DisconnectionType")
  disconnectedBy     String?   @map("DisconnectedBy")
  reconnectedBy      String?   @map("ReconnectedBy")
  // Legacy meaning: 0 = reconnected. Not a delete flag — see removedAt.
  isActive           Boolean?  @default(true) @map("IsActive")
  // Soft delete: a removed disconnection no longer counts against pay.
  removedAt          DateTime? @map("RemovedAt")
  removedBy          String?   @map("RemovedBy")

  user               User      @relation("DisconnectedUser", fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  audits             EmployeeDisconnectionAudit[]

  @@map("EmployeeDisconnections")
  @@schema("benjaise_sqluser2")
}

/// Every add / edit / remove of a disconnection made after the fact.
model EmployeeDisconnectionAudit {
  idAudit           Int       @id @default(autoincrement()) @map("IdAudit")
  idDisconnection   Int       @map("IdDisconnection")
  idUser            Int       @map("IdUser")
  action            String    @map("Action") // 'add' | 'edit' | 'remove'
  disconnectionDate DateTime  @map("DisconnectionDate") @db.Date
  oldStart          DateTime? @map("OldStart") @db.Time
  oldEnd            DateTime? @map("OldEnd") @db.Time
  oldType           String?   @map("OldType")
  newStart          DateTime? @map("NewStart") @db.Time
  newEnd            DateTime? @map("NewEnd") @db.Time
  newType           String?   @map("NewType")
  reason            String    @map("Reason")
  modifiedBy        String    @map("ModifiedBy")
  modifiedAt        DateTime  @default(now()) @map("ModifiedAt")

  disconnection     EmployeeDisconnection @relation(fields: [idDisconnection], references: [idDisconnection], onDelete: NoAction, onUpdate: NoAction)

  @@index([disconnectionDate, idUser], map: "IX_EmployeeDisconnectionAudits_Date")
  @@map("EmployeeDisconnectionAudits")
  @@schema("benjaise_sqluser2")
}

model PayrollBonus {
  idBonus            Int      @id @default(autoincrement()) @map("IdBonus")
  idUser             Int      @map("IdUser")
  periodStart        DateTime @map("PeriodStart") @db.Date
  discretionaryBonus Decimal? @map("DiscretionaryBonus") @db.Decimal(10, 2)
  collectionsBonus   Decimal? @map("CollectionsBonus") @db.Decimal(10, 2)
  trainingBonus      Decimal? @map("TrainingBonus") @db.Decimal(10, 2)
  managerBonus       Decimal? @map("ManagerBonus") @db.Decimal(10, 2)
  wheelSpins         Decimal? @map("WheelSpins") @db.Decimal(10, 2)
  accounts           Decimal? @map("Accounts") @db.Decimal(10, 2)
  reloads            Decimal? @map("Reloads") @db.Decimal(10, 2)
  verifiedLeads      Decimal? @map("VerifiedLeads") @db.Decimal(10, 2)
  // How many accounts / verified leads the amount above is for ("Accounts (4)").
  accountsCount      Int?     @map("AccountsCount")
  verifiedLeadsCount Int?     @map("VerifiedLeadsCount")
  modifiedBy         String?  @map("ModifiedBy")
  modifiedAt         DateTime @default(now()) @map("ModifiedAt")

  user               User     @relation("BonusUser", fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idUser, periodStart], map: "UQ_PayrollBonus_User_Period")
  @@map("PayrollBonuses")
  @@schema("benjaise_sqluser2")
}

/// A bonus earned on a specific day (Wheel Spins, CCF Spiffs), with its own
/// amount. The per-period caps live in DATED_BONUS_RULES. PayrollBonuses
/// .WheelSpins is legacy: its amounts were copied here by migration
/// 20261015_dated_bonuses and the app no longer reads it.
model PayrollBonusEntry {
  idEntry     Int      @id @default(autoincrement()) @map("IdEntry")
  idUser      Int      @map("IdUser")
  periodStart DateTime @map("PeriodStart") @db.Date
  category    String   @map("Category") // 'wheelSpins' | 'ccfSpiffs'
  entryDate   DateTime @map("EntryDate") @db.Date
  amount      Decimal  @map("Amount") @db.Decimal(10, 2)
  modifiedBy  String?  @map("ModifiedBy")
  createdAt   DateTime @default(now()) @map("CreatedAt")

  @@index([idUser, periodStart], map: "IX_PayrollBonusEntries_User_Period")
  @@map("PayrollBonusEntries")
  @@schema("benjaise_sqluser2")
}

// Phase 1 payroll module: an approved/paid PayRun snapshots live numbers
// (hours × rate, OT, each bonus category) into PayStatements that never
// change again, so printing last month's report always matches what was
// actually paid even if rates or punches are edited afterward.
model PayRun {
  idPayRun         Int       @id @default(autoincrement()) @map("IdPayRun")
  periodStart      DateTime  @map("PeriodStart") @db.Date
  periodEnd        DateTime  @map("PeriodEnd") @db.Date
  status           String    @map("Status") // 'approved' | 'paid' | 'void'
  scheduledPayDate DateTime? @map("ScheduledPayDate") @db.Date
  approvedBy       String?   @map("ApprovedBy")
  approvedAt       DateTime? @map("ApprovedAt")
  paidAt           DateTime? @map("PaidAt")
  voidedBy         String?   @map("VoidedBy")
  voidedAt         DateTime? @map("VoidedAt")
  voidReason       String?   @map("VoidReason") @db.NVarChar(500)
  notes            String?   @map("Notes") @db.NVarChar(1000)
  createdAt        DateTime  @default(now()) @map("CreatedAt")

  statements       PayStatement[]

  @@unique([periodStart], map: "UQ_PayRun_Period")
  @@map("PayRuns")
  @@schema("benjaise_sqluser2")
}

model PayStatement {
  idStatement      Int       @id @default(autoincrement()) @map("IdStatement")
  idPayRun         Int       @map("IdPayRun")
  idUser           Int       @map("IdUser")
  employeeName     String    @map("EmployeeName")
  regularHours     Decimal   @map("RegularHours") @db.Decimal(6, 2)
  overtimeHours    Decimal   @map("OvertimeHours") @db.Decimal(6, 2)
  payRate          Decimal?  @map("PayRate") @db.Decimal(10, 2)
  otPayRate        Decimal?  @map("OtPayRate") @db.Decimal(10, 2)
  regularPay       Decimal   @map("RegularPay") @db.Decimal(10, 2)
  overtimePay      Decimal   @map("OvertimePay") @db.Decimal(10, 2)
  bonusTotal       Decimal   @map("BonusTotal") @db.Decimal(10, 2)
  grossPay         Decimal   @map("GrossPay") @db.Decimal(10, 2)
  status           String    @map("Status") // 'pending' | 'paid' | 'void'
  paymentMethod    String?   @map("PaymentMethod")
  paymentReference String?   @map("PaymentReference") @db.NVarChar(200)
  paidDate         DateTime? @map("PaidDate") @db.Date
  snapshotJson     String?   @map("SnapshotJson") @db.NVarChar(Max)
  createdAt        DateTime  @default(now()) @map("CreatedAt")

  payRun           PayRun             @relation(fields: [idPayRun], references: [idPayRun], onDelete: NoAction, onUpdate: NoAction)
  user             User               @relation("PayStatementUser", fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  lines            PayStatementLine[]

  @@unique([idPayRun, idUser], map: "UQ_PayStatement_Run_User")
  @@map("PayStatements")
  @@schema("benjaise_sqluser2")
}

model PayStatementLine {
  idLine      Int      @id @default(autoincrement()) @map("IdLine")
  idStatement Int      @map("IdStatement")
  kind        String   @map("Kind") // 'regular' | 'overtime' | 'bonus'
  category    String?  @map("Category")
  label       String   @map("Label")
  quantity    Decimal? @map("Quantity") @db.Decimal(10, 2)
  rate        Decimal? @map("Rate") @db.Decimal(10, 2)
  amount      Decimal  @map("Amount") @db.Decimal(10, 2)

  statement   PayStatement @relation(fields: [idStatement], references: [idStatement], onDelete: NoAction, onUpdate: NoAction)

  @@map("PayStatementLines")
  @@schema("benjaise_sqluser2")
}

model PayRateHistory {
  idHistory     Int      @id @default(autoincrement()) @map("IdHistory")
  idUser        Int      @map("IdUser")
  payRate       Decimal? @map("PayRate") @db.Decimal(10, 2)
  otPayRate     Decimal? @map("OtPayRate") @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now()) @map("EffectiveFrom")
  changedBy     String?  @map("ChangedBy")

  user          User     @relation("PayRateHistoryUser", fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@map("PayRateHistory")
  @@schema("benjaise_sqluser2")
}

// Which pay week an employee is on from EffectiveFrom on: 'remote' (Fri–Thu)
// or 'inhouse' (Mon–Fri). No rows = remote. See src/lib/payroll/pay-schedule.ts.
model UserPaySchedule {
  idUserPaySchedule Int      @id @default(autoincrement()) @map("IdUserPaySchedule")
  idUser            Int      @map("IdUser")
  schedule          String   @map("Schedule") @db.NVarChar(10)
  effectiveFrom     DateTime @map("EffectiveFrom") @db.Date
  changedBy         String?  @map("ChangedBy") @db.NVarChar(50)
  changedAt         DateTime @default(now()) @map("ChangedAt")

  @@unique([idUser, effectiveFrom], map: "UQ_UserPaySchedule_User_Date")
  @@map("UserPaySchedule")
  @@schema("benjaise_sqluser2")
}

model Video {
  videoId       Int     @id @map("VideoId")
  videoTitle    String  @map("VideoTitle")
  videoFilePath String? @map("VideoFilePath")

  views         VideoView[]

  @@map("Videos")
  @@schema("benjaise_sqluser2")
}

model VideoView {
  id       Int      @id @default(autoincrement()) @map("Id")
  userId   Int      @map("UserId")
  videoId  Int      @map("VideoId")
  viewedOn DateTime @map("ViewedOn")

  user     User     @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  video    Video    @relation(fields: [videoId], references: [videoId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, videoId], map: "UQ_VideoViews_User_Video")
  @@map("VideoViews")
  @@schema("benjaise_sqluser2")
}

model UserActivityLog {
  idLog             Int      @id @default(autoincrement()) @map("IdLog")
  idUser            Int      @map("IdUser")
  action            String   @map("Action")
  actionDescription String   @map("ActionDescription")
  actionTime        DateTime @map("ActionTime")
  additionalDetails String?  @map("AdditionalDetails")

  user              User     @relation(fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@map("UserActivityLog")
  @@schema("benjaise_sqluser")
}

model RolePermission {
  id            Int     @id @default(autoincrement()) @map("Id")
  idRole        Int     @map("IdRole")
  permissionKey String  @map("PermissionKey") @db.NVarChar(50)
  enabled       Boolean @map("Enabled")

  role          Role    @relation(fields: [idRole], references: [idRole])

  @@unique([idRole, permissionKey])
  @@map("RolePermission")
  @@schema("benjaise_sqluser2")
}

model Message {
  id          Int      @id @default(autoincrement()) @map("Id")
  phoneNumber String   @map("PhoneNumber")
  messageBody String   @map("MessageBody")
  direction   String   @map("Direction")
  sentTime    DateTime @map("SentTime")
  isRead      Boolean? @default(false) @map("IsRead")
  status      String?  @map("Status")      // pending | sent | delivered | failed (outbound only)
  gatewayId   String?  @map("GatewayId")   // message ID from sms-gate.app
  mediaData   String?  @map("MediaData") @db.NVarChar(Max)  // base64 encoded (MMS)
  mediaType   String?  @map("MediaType")   // image/jpeg, image/png, application/pdf
  mediaName   String?  @map("MediaName")   // original filename

  @@index([phoneNumber, sentTime], map: "IX_Messages_Phone_SentTime")
  @@index([gatewayId], map: "IX_Messages_GatewayId")
  @@map("Messages")
  @@schema("benjaise_sqluser2")
}

model Contact {
  id          Int      @id @default(autoincrement()) @map("Id")
  phoneNumber String   @unique @map("PhoneNumber")
  name        String   @map("Name")
  updatedAt   DateTime @updatedAt @map("UpdatedAt")

  @@map("SmsContacts")
  @@schema("benjaise_sqluser2")
}

model SmsTemplate {
  id        Int    @id @default(autoincrement()) @map("Id")
  title     String @map("Title")
  body      String @map("Body") @db.NVarChar(Max)
  sortOrder Int    @default(0) @map("SortOrder")

  @@map("SmsTemplates")
  @@schema("benjaise_sqluser2")
}

// ─── Blacklist ─────────────────────────────────────────────────────────────────

model BlockedName {
  id        Int      @id @default(autoincrement()) @map("Id")
  keyword   String   @map("Keyword") @db.NVarChar(200)
  createdAt DateTime @default(now()) @map("CreatedAt")

  @@map("BlockedNames")
  @@schema("dbo")
}

model BlockedAreaCode {
  id        Int      @id @default(autoincrement()) @map("Id")
  areaCode  String   @map("AreaCode") @db.NVarChar(10)
  createdAt DateTime @default(now()) @map("CreatedAt")

  @@map("BlockedAreaCodes")
  @@schema("dbo")
}

// ─── IT Maintenance ────────────────────────────────────────────────────────────

model ComputerAssignment {
  id         Int      @id @default(autoincrement()) @map("Id")
  computerId Int      @map("ComputerId")
  userId     Int      @map("UserId")
  assignedAt DateTime @default(now()) @map("AssignedAt")

  computer   Computer @relation(fields: [computerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User     @relation("ComputerAssignments", fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction)

  @@unique([computerId, userId], map: "UQ_ComputerAssignments_Computer_User")
  @@index([userId], map: "IX_ComputerAssignments_User")
  @@map("ComputerAssignments")
  @@schema("benjaise_sqluser2")
}

model Computer {
  id                        Int      @id @default(autoincrement()) @map("Id")
  computerName              String   @map("ComputerName")
  remotePcId                String?  @map("RemotePcId")
  ipAddress                 String?  @map("IpAddress")
  assignedUserId            Int?     @map("AssignedUserId")
  operatingSystem           String?  @map("OperatingSystem")
  specs                     String?  @map("Specs") @db.NVarChar(Max)
  notes                     String?  @map("Notes") @db.NVarChar(Max)
  status                    String   @default("active") @map("Status")
  maintenanceIntervalMonths Int      @default(3) @map("MaintenanceIntervalMonths")
  createdAt                 DateTime @default(now()) @map("CreatedAt")
  updatedAt                 DateTime @updatedAt @map("UpdatedAt")

  assignedUser       User?                @relation("ComputerUser", fields: [assignedUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  assignments        ComputerAssignment[]
  maintenanceLogs    MaintenanceLog[]
  maintenanceTickets MaintenanceTicket[]

  @@index([status], map: "IX_Computers_Status")
  @@index([assignedUserId], map: "IX_Computers_AssignedUser")
  @@map("Computers")
  @@schema("benjaise_sqluser2")
}

model MaintenanceLog {
  id               Int      @id @default(autoincrement()) @map("Id")
  computerId       Int      @map("ComputerId")
  maintenanceType  String   @map("MaintenanceType")
  performedDate    DateTime @map("PerformedDate")
  technicianId     Int      @map("TechnicianId")
  durationMinutes  Int?     @map("DurationMinutes")
  toolsUsed        String?  @map("ToolsUsed") @db.NVarChar(Max)
  issuesFound      String?  @map("IssuesFound") @db.NVarChar(Max)
  actionsTaken     String?  @map("ActionsTaken") @db.NVarChar(Max)
  notes            String?  @map("Notes") @db.NVarChar(Max)
  relatedTicketId  Int?     @map("RelatedTicketId")
  createdAt        DateTime @default(now()) @map("CreatedAt")

  computer       Computer           @relation(fields: [computerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  technician     User               @relation("MaintenanceTechnician", fields: [technicianId], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  relatedTicket  MaintenanceTicket? @relation(fields: [relatedTicketId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([computerId, performedDate], map: "IX_MaintenanceLogs_Computer_Date")
  @@index([maintenanceType], map: "IX_MaintenanceLogs_Type")
  @@map("MaintenanceLogs")
  @@schema("benjaise_sqluser2")
}

model MaintenanceTicket {
  id                 Int       @id @default(autoincrement()) @map("Id")
  computerId         Int       @map("ComputerId")
  reportedByUserId   Int       @map("ReportedByUserId")
  subject            String    @map("Subject")
  description        String    @map("Description") @db.NVarChar(Max)
  priority           String    @default("normal") @map("Priority")
  status             String    @default("open") @map("Status")
  resolvedDate       DateTime? @map("ResolvedDate")
  resolutionNotes    String?   @map("ResolutionNotes") @db.NVarChar(Max)
  assignedToUserId   Int?      @map("AssignedToUserId")
  createdAt          DateTime  @default(now()) @map("CreatedAt")
  updatedAt          DateTime  @updatedAt @map("UpdatedAt")

  computer        Computer         @relation(fields: [computerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedBy      User             @relation("TicketReporter", fields: [reportedByUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  assignedTo      User?            @relation("TicketAssignee", fields: [assignedToUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction)
  maintenanceLogs MaintenanceLog[]

  @@index([computerId], map: "IX_MaintenanceTickets_Computer")
  @@index([status], map: "IX_MaintenanceTickets_Status")
  @@index([reportedByUserId], map: "IX_MaintenanceTickets_ReportedBy")
  @@map("MaintenanceTickets")
  @@schema("benjaise_sqluser2")
}

model Printer {
  id             Int      @id @default(autoincrement()) @map("Id")
  printerName    String   @map("PrinterName")
  brandModel     String?  @map("BrandModel")
  ipAddress      String?  @map("IpAddress")
  location       String?  @map("Location")
  foldersSharing Boolean  @default(false) @map("FoldersSharing")
  sharedFolders  String?  @map("SharedFolders") @db.NVarChar(Max)
  notes          String?  @map("Notes") @db.NVarChar(Max)
  status         String   @default("active") @map("Status")
  createdAt      DateTime @default(now()) @map("CreatedAt")
  updatedAt      DateTime @updatedAt @map("UpdatedAt")

  @@map("Printers")
  @@schema("benjaise_sqluser2")
}

// ─── Lead Scraping ─────────────────────────────────────────────────────────────

model ScrapeIndustry {
  id     Int     @id @default(autoincrement()) @map("Id")
  name   String  @unique(map: "UX_ScrapeIndustries_Name") @map("Name") @db.NVarChar(100)
  active Boolean @default(true) @map("Active")

  @@map("ScrapeIndustries")
  @@schema("dbo")
}

model ScrapeCity {
  id       Int    @id @default(autoincrement()) @map("Id")
  city     String @map("City") @db.NVarChar(100)
  state    String @map("State") @db.NChar(2)
  timeZone String @map("TimeZone") @db.NVarChar(3)

  @@unique([city, state], map: "UX_ScrapeCities_City_State")
  @@index([state], map: "IX_ScrapeCities_State")
  @@map("ScrapeCities")
  @@schema("dbo")
}

model ScrapeRun {
  id            Int       @id @default(autoincrement()) @map("Id")
  startedAt     DateTime  @default(now()) @map("StartedAt")
  finishedAt    DateTime? @map("FinishedAt")
  tasksDone     Int       @default(0) @map("TasksDone")
  leadsFound    Int       @default(0) @map("LeadsFound")
  leadsImported Int       @default(0) @map("LeadsImported")
  duplicates    Int       @default(0) @map("Duplicates")
  blacklisted   Int       @default(0) @map("Blacklisted")
  invalid       Int       @default(0) @map("Invalid")
  status        String    @map("Status") @db.NVarChar(20)
  finishReason  String?   @map("FinishReason") @db.NVarChar(20)

  tasks ScrapeTask[]

  @@index([startedAt], map: "IX_ScrapeRuns_StartedAt")
  @@map("ScrapeRuns")
  @@schema("dbo")
}

model ScrapeRequest {
  id        Int      @id @default(autoincrement()) @map("Id")
  createdBy String   @map("CreatedBy") @db.NVarChar(200)
  createdAt DateTime @default(now()) @map("CreatedAt")
  status    String   @map("Status") @db.NVarChar(20)
  maxPages  Int      @default(3) @map("MaxPages")
  /// Leased before lower numbers regardless of age. 0 keeps a request in plain
  /// creation order, which is where every existing one stays.
  priority  Int      @default(0) @map("Priority")

  tasks ScrapeTask[]

  @@index([status, createdAt], map: "IX_ScrapeRequests_Status_CreatedAt")
  @@map("ScrapeRequests")
  @@schema("dbo")
}

model ScrapeTask {
  id            Int       @id @default(autoincrement()) @map("Id")
  idRequest     Int       @map("IdRequest")
  idRun         Int?      @map("IdRun")
  industry      String    @map("Industry") @db.NVarChar(100)
  city          String    @map("City") @db.NVarChar(100)
  state         String    @map("State") @db.NChar(2)
  timeZone      String    @map("TimeZone") @db.NVarChar(3)
  status        String    @map("Status") @db.NVarChar(20)
  attempts      Int       @default(0) @map("Attempts")
  leasedAt      DateTime? @map("LeasedAt")
  completedAt   DateTime? @map("CompletedAt")
  foundCount    Int?      @map("FoundCount")
  importedCount Int?      @map("ImportedCount")
  /// Which directory this search reads: 'yp' or 'sp'.
  source        String    @default("yp") @map("Source") @db.NVarChar(10)
  /// Why the rest of FoundCount did not become leads. Kept per task, not only
  /// per run, so the daily report can show a duplicate rate per source.
  duplicateCount   Int? @map("DuplicateCount")
  blacklistedCount Int? @map("BlacklistedCount")
  invalidCount     Int? @map("InvalidCount")
  lastError     String?   @map("LastError") @db.NVarChar(500)

  request ScrapeRequest @relation(fields: [idRequest], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run     ScrapeRun?    @relation(fields: [idRun], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Not unique: coverage expires, so one industry+city holds a row per pass,
  // and per source. Source is the trailing key column because the lookup
  // filters on industry and state; the INCLUDE (Status, CompletedAt) that makes
  // it covering is in the 20260810 migration and cannot be expressed here.
  @@index([industry, state, city, source], map: "IX_ScrapeTasks_Coverage")
  @@index([status, idRequest], map: "IX_ScrapeTasks_Status_Request")
  @@index([idRequest], map: "IX_ScrapeTasks_Request")
  @@map("ScrapeTasks")
  @@schema("dbo")
}
